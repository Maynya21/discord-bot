DISCORD_TOKEN=your-bot-token-here

# personas/ 아래의 파일명. 이 한 줄로 봇 전체 말투가 바뀝니다.
PERSONA=chara

# 대화 기능용. 없으면 슬래시 명령어만 동작합니다.
# https://console.anthropic.com/settings/keys 에서 발급
ANTHROPIC_API_KEY=

# 워크스페이스에 묶이지 않은 키를 쓸 때만 필요합니다.
# 'anthropic-workspace-id is required' 에러가 나면 채우세요. (wrkspc_... 형식)
ANTHROPIC_WORKSPACE_ID=

# 음악 기능에서 스포티파이 링크를 읽을 때만 필요합니다. 없으면 검색어만 받습니다.
# https://developer.spotify.com/dashboard 에서 앱을 만들면 나옵니다.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# 대화에 쓸 모델과 생각 깊이 (low | medium | high | xhigh | max)
PERSONA_MODEL=claude-sonnet-5
PERSONA_EFFORT=low
